COMPOSE_PROJECT_NAME=aem-docker
AEM_AUTHOR_PORT=4502
AEM_PUBLISH_PORT=4503
DISPATCHER_PORT=8080


# --- Dispatcher ---
# Version of the AEM Dispatcher SDK extracted into ./dispatcher (dispatcher-sdk-<version>)
DISPATCHER_SDK_VERSION=2.0.235
# Dispatcher config of ANY AEM project: point to the project's "dispatcher/src" folder
# (the one containing conf.d and conf.dispatcher.d). Absolute or relative path.
# Example: DISPATCHER_CONFIG_DIR=/Users/me/projects/wknd/dispatcher/src
DISPATCHER_CONFIG_DIR=./dispatcher/dispatcher-sdk-2.0.235/src
# Backend AEM instance the dispatcher forwards to (service name inside docker network,
# or host.docker.internal to reach an AEM running directly on your machine)
DISPATCHER_AEM_HOST=publish
DISPATCHER_AEM_PORT=4503
DISP_LOG_LEVEL=Warn
REWRITE_LOG_LEVEL=Warn
# Used by CIF projects in vhost/farm configs (${COMMERCE_ENDPOINT})
COMMERCE_ENDPOINT=http://localhost/graphql
